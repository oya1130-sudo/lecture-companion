# Optional fixed Codex release for reproducible rebuilds. Keep "latest" to
# install the current release from OpenAI's official standalone installer.
CODEX_RELEASE=latest

# The HTTPS URL printed by `tailscale serve status`. Leave blank until Tailscale
# Serve is configured; it only changes the address displayed in the sidebar.
PRESTUDY_PUBLIC_URL=

# Leave blank to use the Codex CLI default model.
PRESTUDY_CODEX_MODEL=

# Conservative defaults for a 4-vCPU, 8-GB personal VM.
PRESTUDY_JOB_WORKERS=3
PRESTUDY_SOURCE_WORKERS=2
PRESTUDY_CODEX_CONCURRENCY=2
