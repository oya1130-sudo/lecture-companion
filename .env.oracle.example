# Install the current Codex CLI release from OpenAI's official installer.
CODEX_RELEASE=latest

# Fill this in after `tailscale serve --bg 8501` prints the private HTTPS URL.
PRESTUDY_PUBLIC_URL=

# Leave blank to use the Codex CLI default model.
PRESTUDY_CODEX_MODEL=

# Conservative settings for Oracle Always Free A1: 2 OCPUs and 12 GB RAM.
PRESTUDY_JOB_WORKERS=2
PRESTUDY_SOURCE_WORKERS=2
PRESTUDY_CODEX_CONCURRENCY=1
